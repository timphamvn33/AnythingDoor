{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": true,
    "types": ["node", "jest"],
    "paths": {
      "@db/*": ["../db/*"],
      "@auth/*": ["./src/auth/*"],
      "@src/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
